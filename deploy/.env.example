# Copy to ".env" (same folder) and edit. Never commit ".env".

# --- Required ---
# Password of the database account "sa". At least 8 characters with upper case, lower case, a digit and a symbol from  _ - !
# Do not use  ; = " ' $ \  or spaces: it is placed inside a connection string.
SA_PASSWORD=Change_me_Strong_123

# The address visitors type, without a trailing slash. It is used in e-mails, the sitemap and canonical links,
# and as the address of the test payment gateway page.
#   on your own machine:      http://localhost:8080
#   behind the tunnel:        the https://something.trycloudflare.com printed by "docker compose logs tunnel"
#   on a server with domain:  https://demo.example.com
PUBLIC_URL=http://localhost:8080

# --- How it is reached ---
# ":80"  = plain HTTP inside (tunnel, or a proxy of your cloud). A domain name = Caddy gets the HTTPS certificate itself.
SITE_ADDRESS=:80
# Ports on the host. On a server of your own with a domain use 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Behaviour ---
# Development: codes for e-mail verification, OTP and password reset are shown on screen, Swagger is open. Test data only!
# Production:  nothing is shown; e-mail must work (see the SMTP block) and the public address must be https.
ASPNETCORE_ENVIRONMENT=Development
# Background jobs (cancel unpaid orders, ledger, reminders). false = run them by hand at /admin/jobs.
JOBS_ENABLED=true
SANDBOX_SECRET=change-me-sandbox-secret

# SQL Server edition: Express (free, any use) or Developer (free, testing only, no size limit)
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=1536

# Folder of the Angular repository, relative to this folder
FRONTEND_DIR=../../nomori-marketplace-frontend

# --- E-mail (optional). Without it, mail waits in the queue shown at /admin/emails ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
