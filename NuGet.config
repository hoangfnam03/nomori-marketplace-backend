<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Audit configuration for security vulnerabilities -->
  <config>
    <!-- Suppress audit errors (convert to warnings) - allows build to continue if vulnerabilities found -->
    <!-- This is a temporary measure while transitive dependencies are being updated -->
    <add key="nuget.audit" value="warn" />
  </config>

  <!-- Suppress specific vulnerabilities that are known and have mitigation plans -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
