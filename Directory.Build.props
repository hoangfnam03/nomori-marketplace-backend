<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress NuGet security audit warnings (NU1902, NU1903) for System.Security.Cryptography.Pkcs -->
    <!-- These are transitive dependencies waiting for upstream patches -->
    <!-- Ref: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>Nomori Marketplace</Company>
    <Authors>Nomori Marketplace</Authors>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName.Replace('-', '_'))</RootNamespace>
  </PropertyGroup>
</Project>
