# Local configuration for the API. Copy to .env (git-ignored) and fill in; never commit .env.
# Keys are configuration paths with "__" between sections. A variable set in the real environment overrides this file.

# GHN (Giao Hang Nhanh) — test account at https://5sao.ghn.dev
Shipping__Ghn__Enabled=false
# Token API: 5sao.ghn.dev > Chủ cửa hàng > Xem thông tin
Shipping__Ghn__Token=
# ShopId: 5sao.ghn.dev > Quản lý cửa hàng (the shop id, not the client id)
Shipping__Ghn__ShopId=0
# Any long random string; GHN sends it back in the X-Nomori-Webhook-Secret header (webhook settings > custom headers)
Shipping__Ghn__WebhookSecret=
