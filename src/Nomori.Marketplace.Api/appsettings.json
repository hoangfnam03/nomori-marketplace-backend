{
  "Application": {
    "Name": "Nomori Marketplace",
    "Version": "foundation"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Nomori Marketplace",
    "UseSsl": false,
    "UseStartTls": true,
    "FrontendBaseUrl": "",
    "PasswordRecoverySubject": "Reset your Nomori Marketplace password",
    "EmailVerificationSubject": "Verify your Nomori Marketplace email",
    "EmailOtpSubject": "Your Nomori Marketplace verification code"
  },
  "Authentication": {
    "CookieName": "Nomori.Auth",
    "Scheme": "NomoriCookie",
    "LoginPath": "/api/v1/auth/login",
    "AccessDeniedPath": "/api/v1/auth/forbidden",
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RecoveryTokenLifetimeMinutes": 30,
    "MinimumPasswordLength": 12,
    "PasswordHistoryLimit": 5,
    "SessionLifetimeMinutes": 60,
    "RememberMeLifetimeDays": 30,
    "EmailVerificationTokenLifetimeHours": 24,
    "EmailOtpLifetimeMinutes": 10,
    "EmailOtpMaxAttempts": 5,
    "EmailOtpResendDelaySeconds": 60
  },
  "OpenApi": {},
  "MultiStore": {},
  "Localization": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
