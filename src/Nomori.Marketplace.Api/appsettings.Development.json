{
  "Application": {
    "Name": "Nomori Marketplace Development",
    "Version": "foundation"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Authentication": {
    "CookieName": "Nomori.Auth.Development",
    "Scheme": "NomoriCookie",
    "LoginPath": "/api/v1/auth/login",
    "AccessDeniedPath": "/api/v1/auth/forbidden"
  },
  "OpenApi": {},
  "MultiStore": {},
  "Localization": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
