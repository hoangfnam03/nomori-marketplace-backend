{
  "Application": {
    "Name": "Nomori Marketplace Development",
    "Version": "foundation"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=NomoriMarketplace_Db;Integrated Security=True;TrustServerCertificate=True;Application Name=Nomori Marketplace Api"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Email": {
    "Enabled": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "hoangnamsomething@gmail.com",
    "Password": "",
    "FromAddress": "hoangnamsomething@gmail.com",
    "FromName": "Nomori Marketplace",
    "UseSsl": false,
    "UseStartTls": true,
    "FrontendBaseUrl": "http://localhost:4200",
    "PasswordRecoverySubject": "Reset your Nomori Marketplace password"
  },
  "Authentication": {
    "CookieName": "Nomori.Auth.Development",
    "Scheme": "NomoriCookie",
    "LoginPath": "/api/v1/auth/login",
    "AccessDeniedPath": "/api/v1/auth/forbidden",
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RecoveryTokenLifetimeMinutes": 30
  },
  "OpenApi": {},
  "MultiStore": {},
  "Localization": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
